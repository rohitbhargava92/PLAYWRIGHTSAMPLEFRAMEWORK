{
  "name": "playwrightsampleframework",
  "version": "1.0.0",
  "description": "To run things on CLI use command line npm run test:dev, npm run test:qa, npm run test:stage, npm run test:prod",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --grep @e2e",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:stage": "cross-env ENV=stage playwright test",
    "test:prod": "cross-env ENV=prod playwright test"
  },
  "keywords": [],
  "author": "rohit bhargava",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  }
}
